# Copia este archivo como ".env" (en la carpeta servidor) y llena los valores.
# Después reinicia el servidor con: npm start

# --- Base de datos (opcional: si no se ponen, se usan los valores de db.js) ---
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=tu_contraseña_de_mysql
# DB_NAME=colsagraco

# --- SMS con Twilio (para enviar el PIN de recuperación) ---
# Si estas tres líneas están vacías, el PIN se muestra en la consola (modo prueba).
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM=+1xxxxxxxxxx
